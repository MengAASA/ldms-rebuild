// LDMS v2 schema.
// Phase 1: org chart, staff, roles, audit log and settings.
// Phase 2: trainings, sessions and participants.
// Phase 3: PME, the skill matrix, TNA and TNI.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StaffStatus {
  ACTIVE
  RESIGNED
}

enum Designation {
  NON_EXECUTIVE
  EXECUTIVE
  MANAGER
  CONTRACT
  TRAINEE
}

// Roles granted explicitly. HOD and division head are not roles: they come
// from Department.hodId and Division.headId, so they can never disagree
// with the org chart.
enum RoleCode {
  LD_ADMIN
  MAIN_CLERK
  CLERK
  SKILL_EVALUATOR // may fill in skill matrices for their department (phase 3); replaces the old whitelist
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  IMPORT
}

model Division {
  id          Int          @id @default(autoincrement())
  name        String       @unique @db.VarChar(120)
  shortName   String?      @db.VarChar(20)
  headId      Int?
  legacyId    Int?         @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  head        Staff?       @relation("DivisionHead", fields: [headId], references: [id], onDelete: SetNull)
  departments Department[]
}

model Department {
  id         Int        @id @default(autoincrement())
  divisionId Int
  name       String     @db.VarChar(120)
  shortName  String?    @db.VarChar(20)
  hodId      Int? // replaces the trigger that rewrote user.hodid
  legacyId   Int?       @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  division   Division   @relation(fields: [divisionId], references: [id])
  hod        Staff?     @relation("DepartmentHod", fields: [hodId], references: [id], onDelete: SetNull)
  sections   Section[]
  staff      Staff[]    @relation("DepartmentStaff")
  trainings  Training[]
  tnas       Tna[]
  tnis       Tni[]

  @@unique([divisionId, name])
  @@index([hodId])
}

model Section {
  id           Int        @id @default(autoincrement())
  departmentId Int
  name         String     @db.VarChar(120)
  shortName    String?    @db.VarChar(20) // as on the old system; shown beside the name
  legacyId     Int?       @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id])
  staff        Staff[]

  @@unique([departmentId, name])
}

enum Gender {
  MALE
  FEMALE
}

model Staff {
  id                 Int               @id @default(autoincrement())
  staffNo            String            @unique @db.VarChar(20) // the old table allowed duplicates
  name               String            @db.VarChar(160)
  email              String?           @db.VarChar(160)
  position           String?           @db.VarChar(120)
  designation        Designation
  gender             Gender? // as on the old system's staff record; the audit reports list it
  plant              String?           @db.VarChar(60) // where they work, as on the old system's staff record
  status             StaffStatus       @default(ACTIVE)
  dateJoined         DateTime?         @db.Date
  dateResigned       DateTime?         @db.Date
  jobGrade           Int?              @db.TinyInt // 1 to 5; TNA by job grade (phase 3). Null: none
  fillsOwnTna        Boolean           @default(false) // a non-executive who fills in their own TNA (the old "office" user)
  departmentId       Int
  sectionId          Int?
  passwordHash       String?           @db.VarChar(255) // argon2id
  legacyMd5          String?           @db.Char(32) // cleared after the first sign-in
  mustChangePassword Boolean           @default(false)
  sessionVersion     Int               @default(0) // bumped on password reset/change; older sessions stop working
  lastSignInAt       DateTime?
  legacyId           Int?              @unique
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  department         Department        @relation("DepartmentStaff", fields: [departmentId], references: [id])
  section            Section?          @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  roles              StaffRole[]
  hodOf              Department[]      @relation("DepartmentHod")
  headOf             Division[]        @relation("DivisionHead")
  auditEntries       AuditLog[]
  participants       Participant[]
  trainerOf          Training[]        @relation("TrainingTrainer")
  pmeEvaluated       Pme[]             @relation("PmeEvaluator")
  pmeVerified        Pme[]             @relation("PmeVerifier")
  skillEvaluations   SkillEvaluation[] @relation("SkillSubject")
  skillCreated       SkillEvaluation[] @relation("SkillCreator")
  skillApproved      SkillEvaluation[] @relation("SkillApprover")
  tnas               Tna[]             @relation("TnaSubject")
  tnaCreated         Tna[]             @relation("TnaCreator")
  tnaSubmitted       Tna[]             @relation("TnaSubmitter")
  tnaApproved        Tna[]             @relation("TnaApprover")
  tnaReturned        Tna[]             @relation("TnaReturner")
  tniUpdated         Tni[]
  jobRuns            JobRun[]
  emails             EmailMessage[]
  notifications      Notification[]

  @@index([departmentId, status])
  @@index([designation, status])
  @@index([name])
}

model StaffRole {
  staffId   Int
  role      RoleCode
  grantedAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([staffId, role])
}

model AuditLog {
  id        BigInt      @id @default(autoincrement())
  actorId   Int?
  action    AuditAction
  entity    String      @db.VarChar(40)
  entityId  String?     @db.VarChar(40)
  summary   String      @db.VarChar(255)
  changes   Json? // { field: [before, after] }
  createdAt DateTime    @default(now())
  actor     Staff?      @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Setting {
  key         String   @id @db.VarChar(80)
  value       Json
  updatedAt   DateTime @updatedAt
  updatedById Int?
}

// ---------- Phase 2: training ----------

enum TrainingType {
  PUBLIC_INHOUSE // a course for staff, run by an external provider or at PHN
  OJT // on-the-job training
}

// The next three lists match the old system's Add Training form.
enum TrainingProgram {
  EXTERNAL_PUBLIC // external public program
  INTERNAL_EXTERNAL_TRAINER // internal training by an external trainer
  INTERNAL_INTERNAL_TRAINER // internal training by an internal trainer
}

enum TrainingFunction {
  BUSINESS
  DIGITAL
  LEADERSHIP
  PERSONAL_EFFECTIVENESS
}

enum TrainingPlatform {
  PHYSICAL
  ONLINE
}

// How an OJT is given: "Training Type" on the old system's OJT form.
enum OjtMethod {
  OJT // on-the-job training
  COACHING // coaching / coachee
  MENTORING // mentor / mentee
}

enum TrainingStatus {
  SCHEDULED
  CANCELLED
}

enum Attendance {
  PENDING
  COMPLETED
  ABSENT
}

enum ParticipantSource {
  ADMIN // added by L&D
  CLERK // OJT entered or imported by a clerk
  SELF // OJT recorded by the staff member
  IMPORT // Excel import
}

model Training {
  id              Int               @id @default(autoincrement())
  type            TrainingType
  title           String            @db.VarChar(200)
  trainingCode    String            @unique @db.VarChar(20) // automatic: TR (OJT for OJT) + the day it was added (YYYYMMDD) + 6 random digits; never changes
  code            String?           @db.VarChar(40) // the provider's course code, if any
  provider        String?           @db.VarChar(160) // training provider / organiser
  trainerName     String?           @db.VarChar(160) // free text, or a copy of the internal trainer's name
  trainerStaffId  Int? // set only for "internal training by internal trainer"
  venue           String?           @db.VarChar(160)
  program         TrainingProgram? // required on the form except for OJT; for OJT, the external/internal trainer
  ojtMethod       OjtMethod? // OJT only: OJT, coaching or mentoring
  function        TrainingFunction?
  platform        TrainingPlatform?
  category        String?           @db.VarChar(80)
  hrdfClaimable   Boolean           @default(false) // "HRDC" on screen (HRD Corp, formerly HRDF)
  cost            Decimal?          @db.Decimal(12, 2) // RM, whole course
  description     String?           @db.Text
  startDate       DateTime          @db.Date
  endDate         DateTime          @db.Date
  startTime       DateTime          @db.Time(0)
  endTime         DateTime          @db.Time(0)
  status          TrainingStatus    @default(SCHEDULED)
  // The certificate: one file for the whole training, as providers send it (module 5).
  certificateFile String?           @db.VarChar(255) // stored name under uploads/certificates, e.g. 2026/<random id>.pdf
  certificateName String?           @db.VarChar(255) // original file name, for download
  certificateAt   DateTime?
  certificateById Int? // who uploaded it
  departmentId    Int? // organising department (OJT)
  createdById     Int?
  legacySource    String?           @db.VarChar(10) // "training" | "ojt": old IDs overlap between tables
  legacyId        Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  department      Department?       @relation(fields: [departmentId], references: [id])
  trainerStaff    Staff?            @relation("TrainingTrainer", fields: [trainerStaffId], references: [id], onDelete: SetNull)
  sessions        TrainingSession[]
  participants    Participant[]

  @@unique([legacySource, legacyId])
  @@index([type, startDate]) // replaces the old *_archive tables
  @@index([startDate])
}

// Optional. Only for trainings whose days are not consecutive or whose times
// differ per day. Without sessions, hours come from the date range × daily hours.
model TrainingSession {
  id         Int      @id @default(autoincrement())
  trainingId Int
  date       DateTime @db.Date
  startTime  DateTime @db.Time(0)
  endTime    DateTime @db.Time(0)
  training   Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  @@unique([trainingId, date, startTime])
}

model Participant {
  id               Int               @id @default(autoincrement())
  trainingId       Int
  staffId          Int
  attendance       Attendance        @default(PENDING)
  source           ParticipantSource @default(ADMIN)
  recordedById     Int? // who added the row (clerk, admin or the staff member)
  attendanceReason String?           @db.VarChar(255) // why absent, or why an admin marked it completed for them
  feedback         Json? // answers, shape checked by the Zod schema for feedbackVersion
  feedbackVersion  Int?
  submittedAt      DateTime?
  legacyId         Int?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  training         Training          @relation(fields: [trainingId], references: [id])
  staff            Staff             @relation(fields: [staffId], references: [id])
  pme              Pme?

  @@unique([trainingId, staffId])
  @@index([staffId, attendance])
  @@index([attendance, trainingId])
}

// ---------- Phase 3: PME (Performance Monitoring Evaluation) ----------

// PENDING covers both "still in the evaluation period" and "waiting for the
// HOD": which one follows from periodEnd and today (rules/pme.ts).
enum PmeStatus {
  NOT_REQUIRED // short training (4 hours or less): no evaluation
  PENDING // waiting for the HOD, who may evaluate once the period has ended
  EVALUATED // the HOD has evaluated; waiting for the staff member
  ACKNOWLEDGED // the staff member has acknowledged; waiting for L&D
  VERIFIED // L&D has verified; locked
}

// One per person per training, made when their attendance becomes Completed
// (rules/pme.ts: pmeRequirement). Who evaluates is not stored: it is the
// person's approver today (rules/approver.ts), so moving a HOD moves the work.
model Pme {
  id             Int         @id @default(autoincrement())
  participantId  Int         @unique
  status         PmeStatus   @default(PENDING)
  periodStart    DateTime    @db.Date // the day after the training ends
  periodEnd      DateTime    @db.Date // three months later; the HOD evaluates after this day
  answers        Json? // the four ratings, percentages and remarks; shape checked by the Zod schema for answersVersion
  answersVersion Int?
  ojtConducted   Boolean? // question 1: was OJT conducted after the training
  averageMark    Decimal?    @db.Decimal(5, 2) // out of 100; set when verified
  evaluatedById  Int?
  evaluatedAt    DateTime?
  staffComment   String?     @db.VarChar(500) // optional, given when acknowledging
  acknowledgedAt DateTime?
  verifiedById   Int?
  verifiedAt     DateTime?
  returnReason   String?     @db.VarChar(255) // why L&D sent it back to the HOD; cleared when evaluated again
  returnedAt     DateTime?
  legacyId       Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  participant    Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  evaluatedBy    Staff?      @relation("PmeEvaluator", fields: [evaluatedById], references: [id], onDelete: SetNull)
  verifiedBy     Staff?      @relation("PmeVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([status, periodEnd])
}

// ---------- Phase 3: skill matrix ----------

enum SkillSection {
  KNOWLEDGE
  SKILL
  ABILITY
}

enum SkillStatus {
  DRAFT // being filled in, or sent back by the HOD (returnReason says why)
  SUBMITTED // waiting for the HOD
  APPROVED // locked
}

// One per staff member per quarter. The quarter is stored, never worked out
// from a date: it is the quarter evaluated, which is filled in during the
// quarter after it (rules/skill.ts).
model SkillEvaluation {
  id           Int               @id @default(autoincrement())
  staffId      Int
  year         Int               @db.SmallInt
  quarter      Int               @db.TinyInt // 1 to 4
  status       SkillStatus       @default(DRAFT)
  createdById  Int? // the evaluator
  copiedFromId Int? // the matrix it was duplicated from, if any
  submittedAt  DateTime?
  approvedById Int?
  approvedAt   DateTime?
  returnReason String?           @db.VarChar(255) // why the HOD sent it back; cleared when submitted again
  returnedAt   DateTime?
  legacyId     Int?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  staff        Staff             @relation("SkillSubject", fields: [staffId], references: [id])
  createdBy    Staff?            @relation("SkillCreator", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy   Staff?            @relation("SkillApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  copiedFrom   SkillEvaluation?  @relation("SkillCopy", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies       SkillEvaluation[] @relation("SkillCopy")
  topics       SkillTopic[]

  @@unique([staffId, year, quarter])
  @@index([year, quarter, status])
}

model SkillTopic {
  id           Int             @id @default(autoincrement())
  evaluationId Int
  section      SkillSection
  name         String          @db.VarChar(500)
  sortOrder    Int             @db.SmallInt
  evaluation   SkillEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  items        SkillItem[]

  @@index([evaluationId, section, sortOrder])
}

// A line under a topic: a sentence and its rating. A draft may hold a line
// without a rating yet; a submitted matrix never does.
model SkillItem {
  id        Int        @id @default(autoincrement())
  topicId   Int
  text      String     @db.Text
  rating    Int?       @db.TinyInt // 1 Beginner to 5 Expert
  sortOrder Int        @db.SmallInt
  topic     SkillTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId, sortOrder])
}

// ---------- Phase 3: TNA (Training Need Analysis) ----------

enum TnaSection {
  ESG // a. ESG (Environment, Social, Governance)
  SOFT_SKILLS // b. Soft skills
  LEADERSHIP // c. Leadership awareness
  DATA_DRIVEN // d. Data driven
  FUNCTIONAL // e. Functional awareness
  DIGITAL // f. Digital transformation and innovation
  SPECIAL_PROJECT // g. Special project
}

enum TnaMethod {
  OJT // on-job training
  COACHING
  EXTERNAL_INHOUSE // an external or in-house course
}

enum TnaStatus {
  DRAFT // being filled in, or sent back (returnReason says why)
  SUBMITTED // waiting for the HOD
  APPROVED // locked; L&D can reopen it
}

// One per year for a person who fills in their own (staffId), or for a job
// grade in a department (departmentId + jobGrade), entered by the main clerk
// (rules/tna.ts). Exactly one of the two is set. MySQL lets a unique index
// hold many NULLs, so the two unique indexes don't get in each other's way.
model Tna {
  id            Int         @id @default(autoincrement())
  year          Int         @db.SmallInt
  staffId       Int? // an individual's TNA ...
  departmentId  Int? // ... or a job grade's, in a department
  jobGrade      Int?        @db.TinyInt // 1 to 5
  status        TnaStatus   @default(DRAFT)
  createdById   Int?
  submittedById Int?
  submittedAt   DateTime?
  approvedById  Int?
  approvedAt    DateTime?
  returnReason  String?     @db.VarChar(255) // why the HOD sent it back, or L&D reopened it; cleared when submitted again
  returnedById  Int?
  returnedAt    DateTime?
  legacyId      Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  staff         Staff?      @relation("TnaSubject", fields: [staffId], references: [id])
  department    Department? @relation(fields: [departmentId], references: [id])
  createdBy     Staff?      @relation("TnaCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submittedBy   Staff?      @relation("TnaSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedBy    Staff?      @relation("TnaApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  returnedBy    Staff?      @relation("TnaReturner", fields: [returnedById], references: [id], onDelete: SetNull)
  items         TnaItem[]

  @@unique([year, staffId])
  @@unique([year, departmentId, jobGrade])
  @@index([year, status])
}

// A row of the form. A draft may hold a row that isn't finished; a submitted
// TNA never does. The gap (target minus current) is worked out, not stored.
model TnaItem {
  id           Int                @id @default(autoincrement())
  tnaId        Int
  section      TnaSection
  sortOrder    Int                @db.SmallInt
  problem      String             @db.Text // problem statement
  optionId     Int? // the training option picked; null for "Others" (and for a draft row with none yet)
  trainingName String             @db.VarChar(255) // the option's name, or what was typed for "Others"
  targetSkill  Int?               @db.TinyInt // 1 to 5
  currentSkill Int?               @db.TinyInt // 1 to 5
  method       TnaMethod?
  month        Int?               @db.TinyInt // 1 to 12: when
  tna          Tna                @relation(fields: [tnaId], references: [id], onDelete: Cascade)
  option       TnaTrainingOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([tnaId, section, sortOrder])
  @@index([optionId])
}

// "Training required": the lists L&D keep for each section of the form.
// A section's options may be put in groups (Functional awareness has twelve).
model TnaTrainingCategory {
  id        Int                 @id @default(autoincrement())
  section   TnaSection
  name      String              @db.VarChar(255)
  sortOrder Int
  options   TnaTrainingOption[]

  @@unique([section, name])
}

model TnaTrainingOption {
  id          Int                  @id @default(autoincrement())
  section     TnaSection
  categoryId  Int?
  name        String               @db.VarChar(255)
  sortOrder   Int
  active      Boolean              @default(true) // hidden options can't be picked for new rows; rows already saved keep them
  updatedById Int?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  category    TnaTrainingCategory? @relation(fields: [categoryId], references: [id])
  items       TnaItem[]

  @@index([section, sortOrder])
}

// ---------- Phase 3: TNI (Training Need Identification) ----------

// A department's list for a year, kept by its HOD: where performance falls
// short of what is expected, why, and how the gap will be closed. No approval
// and no statuses: what is saved is the record (rules/tni.ts).
model Tni {
  id           Int        @id @default(autoincrement())
  year         Int        @db.SmallInt
  departmentId Int
  updatedById  Int? // who saved it last
  legacyId     Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id])
  updatedBy    Staff?     @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  items        TniItem[]

  @@unique([year, departmentId])
}

// A row of the list. The gap (expected minus actual) is worked out, not stored.
model TniItem {
  id         Int       @id @default(autoincrement())
  tniId      Int
  sortOrder  Int       @db.SmallInt
  indicator  String    @db.Text // performance indicator (critical to quality or process)
  expected   Int       @db.TinyInt // 1 to 5
  actual     Int       @db.TinyInt // 1 to 5
  causes     String    @db.VarChar(500) // possible causes
  ask        String    @db.VarChar(255) // attitude, skill or knowledge
  method     TnaMethod // L&D method: the same three as the TNA's
  evaluation String    @db.VarChar(255) // evaluation method
  tni        Tni       @relation(fields: [tniId], references: [id], onDelete: Cascade)

  @@index([tniId, sortOrder])
}

// ---------- Phase 4: the daily job, email and notifications ----------

enum JobStatus {
  RUNNING
  OK
  FAILED
}

// One row per run of the daily job (npm run job:daily, or L&D's Run now).
model JobRun {
  id          Int            @id @default(autoincrement())
  job         String         @db.VarChar(40) // "daily"
  startedAt   DateTime       @default(now())
  finishedAt  DateTime?
  status      JobStatus      @default(RUNNING)
  summary     Json? // counts: emails sent, failed, removed
  error       String?        @db.Text
  startedById Int? // null: the server's scheduler started it
  startedBy   Staff?         @relation(fields: [startedById], references: [id], onDelete: SetNull)
  emails      EmailMessage[]

  @@index([job, startedAt])
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
  RECORDED // written down while sending was switched off; never sent
}

// One row per email: who it was meant for, where it really went (the test
// address in test mode) and what happened. Written before sending, so nothing
// is sent twice. Bodies name staff, so rows are removed after 90 days.
model EmailMessage {
  id         Int         @id @default(autoincrement())
  kind       String      @db.VarChar(40) // "test", "digest"
  staffId    Int? // who it is for
  intendedTo String      @db.VarChar(160)
  sentTo     String      @db.VarChar(160)
  subject    String      @db.VarChar(200)
  body       String      @db.MediumText // HTML
  dedupeKey  String      @unique @db.VarChar(80) // "digest:<staffId>:<YYYY-MM-DD>"
  status     EmailStatus @default(QUEUED)
  attempts   Int         @default(0)
  error      String?     @db.VarChar(500)
  jobRunId   Int?
  createdAt  DateTime    @default(now())
  sentAt     DateTime?
  staff      Staff?      @relation(fields: [staffId], references: [id], onDelete: SetNull)
  jobRun     JobRun?     @relation(fields: [jobRunId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status, createdAt])
}

// The bell: something happened to one of the person's records (module 1).
model Notification {
  id        Int       @id @default(autoincrement())
  staffId   Int
  kind      String    @db.VarChar(40) // "tna.returned", "pme.evaluated", ...
  title     String    @db.VarChar(200)
  href      String    @db.VarChar(200)
  entity    String    @db.VarChar(40)
  entityId  Int
  createdAt DateTime  @default(now())
  readAt    DateTime?
  staff     Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, readAt, createdAt])
  @@index([entity, entityId])
}
